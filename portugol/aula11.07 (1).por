programa
{
	
	funcao inicio()
	{
		cadeia nome_usuario="Cecília"
		inteiro dia=09
		real distancia=10.2
		escreva ("\nNome: ", nome_usuario, "\nDia: ", dia, "\nDistancia: ", distancia)
		caracter letra = 'A'
		escreva("\n", letra)

		logico situacao_cadastro = verdadeiro
		escreva("\n", situacao_cadastro)
		}
}
